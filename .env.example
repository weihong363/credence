# 仅供服务端使用；在本地填写，不要把 Secret 发到聊天中。
# Sandbox REST App 的 Client ID 和 Client Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 接收款项的同一个 Sandbox Business 账号的 Merchant ID（不是 Client ID）
PAYPAL_MERCHANT_ID=
# 本地接口访问令牌，至少 32 个随机字符；不是 PayPal 凭据
OWNER_TOKEN=
PUBLIC_URL=http://localhost:3000

# Optional local server defaults; Render uses .env.render.example / platform variables.
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
