# Documentation template only: enter values in Render Environment, not a public .env file.
NODE_ENV=production
HOST=0.0.0.0
DATA_DIR=/var/data/credence
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
# Blueprint generates OWNER_TOKEN; use a fresh random value of at least 32 characters if set manually.
OWNER_TOKEN=
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Leave PUBLIC_URL unset unless configuring a custom HTTPS origin.
# No DATABASE_URL, LLM credentials, frontend API URL or CORS allowlist is consumed by P0.
# P3.4 optional server-only mission configuration; missing settings disable execution.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_API_KEY=
